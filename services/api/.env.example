# ============================================================
# NIRVANA API — Environment Variables Template
# Copy this file to .env and fill in real values.
# The real .env is git-ignored and must never be committed.
# ============================================================

# ----- Server -----
NODE_ENV=development
PORT=3000

# ----- JWT -----
JWT_SECRET=your_jwt_secret_here

# ----- PostgreSQL -----
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=nirvana
DB_PASSWORD=your_db_password_here
DB_NAME=nirvana

# ----- Redis -----
REDIS_URL=redis://127.0.0.1:6379

# ----- External Services -----
GRAPHHOPPER_URL=http://127.0.0.1:8989
RISK_ENGINE_URL=http://127.0.0.1:8000

# OpenWeatherMap
OPENWEATHERMAP_API_KEY=your_owm_key_here

# ImageKit
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
